APP_ENV=development
APP_VERSION=0.1.0
APP_SECRET_KEY=change-this-in-production-use-at-least-32-bytes
DATA_SOURCE_MASTER_KEYS={"dev-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
DATA_SOURCE_ACTIVE_KEY_VERSION=dev-v1
DATA_SOURCE_ALLOWED_PRIVATE_CIDRS=["172.16.0.0/12"]
DATA_SOURCE_ALLOWED_PORTS=[5432,3306]
METADATA_SCAN_MAX_OBJECTS=10000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
POSTGRES_DB=zhixi
POSTGRES_USER=zhixi
POSTGRES_PASSWORD=zhixi-local-only
DATABASE_URL=postgresql+psycopg://zhixi:zhixi-local-only@postgres:5432/zhixi
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=zhixi-local
S3_SECRET_KEY=zhixi-local-secret
S3_BUCKET=zhixi-artifacts
MINIO_ROOT_USER=zhixi-local
MINIO_ROOT_PASSWORD=zhixi-local-secret
VITE_API_BASE_URL=http://localhost:8000
